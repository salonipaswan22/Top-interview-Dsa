class Solution {
    public int rob(int[] nums) {
        int prev2 = 0; // maximum before previous house
        int prev1 = 0; // maximum up to previous house

        for (int money : nums) {
            int current = Math.max(prev1, prev2 + money);

            prev2 = prev1;
            prev1 = current;
        }

        return prev1;
    }
}
